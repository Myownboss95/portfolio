# Cloudflare asset headers.
#
# Pages must always be re-checked with the server, so a browser never shows an
# old page that points at CSS/JS from a previous deploy (the "page loads with no
# styles" problem). Hashed build files in /_astro/ never change once published,
# so they can be cached forever.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
