{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-01-01",
  // Static Astro build output, served by Cloudflare's asset layer. `npm run build`
  // produces dist/; `wrangler deploy` uploads it along with the Worker below.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths wake the Worker; every page and file is served straight
    // from the asset layer exactly as before.
    "run_worker_first": ["/api/*", "/files/*"]
  },
  // "Start a project" uploads and saved briefs. Private — files are only
  // reachable through /files/<brief id>.
  "r2_buckets": [{ "binding": "BRIEFS", "bucket_name": "portfolio-briefs" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }],
  "vars": {
    "MAIL_FROM": "Daniel Odiachi <projects@danielodiachi.work>",
    // Where new briefs are sent (Daniel), and the address clients reply to —
    // the projects@ mailbox on Namecheap Private Email.
    "NOTIFY_EMAIL": "tobeodiachi2014@gmail.com",
    "REPLY_TO": "projects@danielodiachi.work",
    "SITE_URL": "https://danielodiachi.work",
    "WHATSAPP_URL": "https://wa.me/2348131886973"
  }
  // Secret (not in this file): RESEND_API_KEY — set with `npx wrangler secret put RESEND_API_KEY`.
}
