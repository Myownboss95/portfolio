---
// "Start a project" call-to-action for website clients, in three sizes:
//   banner — full-width section (home, work)
//   card   — compact box (contact, about, blog)
//   link   — one line of text (hero, footer)
// All of them point at /start-a-project (src/pages/start-a-project.astro).
interface Props {
  variant?: 'banner' | 'card' | 'link';
  class?: string;
}

const { variant = 'card', class: className } = Astro.props;
const href = '/start-a-project';
const kinds = ['Company', 'E-commerce', 'Church', 'NGO'];
---

{
  variant === 'link' && (
    <a href={href} class:list={['cta-link group inline-flex items-center gap-1.5 text-sm text-muted', className]}>
      <span class="status-dot" aria-hidden="true" />
      Need a website for your business, church or NGO?
      <span class="font-medium text-accent">
        Start a project <span class="cta-arrow inline-block" aria-hidden="true">→</span>
      </span>
    </a>
  )
}

{
  variant === 'card' && (
    <a href={href} class:list={['cta-card group block rounded-xl border p-5', className]}>
      <p class="font-mono text-xs uppercase tracking-wider text-accent">Websites</p>
      <p class="mt-1.5 text-lg font-semibold text-main">Need a website for your business, church or NGO?</p>
      <p class="mt-1 text-sm text-muted">Answer a few quick questions and see an estimated price in about 3 minutes.</p>
      <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
        Start a project <span class="cta-arrow inline-block" aria-hidden="true">→</span>
      </span>
    </a>
  )
}

{
  variant === 'banner' && (
    <section class:list={['border-t border-app', className]}>
      <div class="mx-auto max-w-5xl px-5 py-16">
        <div class="cta-banner reveal relative overflow-hidden rounded-2xl border p-7 sm:p-10">
          <div class="cta-glow" aria-hidden="true" />
          <p class="relative font-mono text-xs uppercase tracking-wider text-accent">Websites</p>
          <h2 class="relative mt-2 max-w-2xl text-2xl font-bold tracking-tight text-main sm:text-3xl">
            Need a website that brings in customers, members or donors?
          </h2>
          <p class="relative mt-3 max-w-xl text-muted">
            I design and build websites for companies, online stores, churches and NGOs — hosting
            included. Tell me what you need and see an estimated price in about 3 minutes.
          </p>
          <ul class="relative mt-5 flex flex-wrap gap-2" role="list">
            {kinds.map((k) => (
              <li class="rounded-full border border-app bg-soft px-3 py-1 text-xs text-muted">{k}</li>
            ))}
          </ul>
          <a
            href={href}
            class="cta-button group relative mt-7 inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-[#06140f]"
          >
            Start a project <span class="cta-arrow inline-block" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .group:hover .cta-arrow,
  .group:focus-visible .cta-arrow {
    transform: translateX(3px);
  }
  .cta-link:hover {
    color: var(--text);
  }
  .cta-card {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-card));
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .cta-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .cta-banner {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-card));
  }
  .cta-glow {
    position: absolute;
    right: -8rem;
    top: -10rem;
    height: 22rem;
    width: 22rem;
    border-radius: 9999px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    pointer-events: none;
  }
  .cta-button {
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .cta-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-card:hover,
    .cta-button:hover {
      transform: none;
    }
  }
</style>
