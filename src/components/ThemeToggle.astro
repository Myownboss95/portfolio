---
// Dark/light toggle. No framework — just a tiny inline script island.
//
// Safe to render more than once (the header has one in the desktop bar and one
// in the mobile menu): the icon is chosen by CSS from the theme class on <html>,
// and a single delegated click listener drives every instance.
interface Props {
  /** Display utility for the button. Defaults to `grid`. */
  class?: string;
}

const { class: className = 'grid' } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class:list={[
    'h-9 w-9 shrink-0 place-items-center rounded-md border border-app text-muted transition hover:text-accent',
    className,
  ]}
>
  <svg class="theme-sun h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-moon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<style>
  /* Moon in dark, sun in light. The theme class is set before first paint
     (BaseHead), so the right glyph shows immediately — no JS needed. */
  .theme-sun {
    display: none;
  }
  :global(html.light) .theme-sun {
    display: block;
  }
  :global(html.light) .theme-moon {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    // Rendered once per instance; bind only once.
    if (window.__themeToggleBound) return;
    window.__themeToggleBound = true;
    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element && e.target.closest('[data-theme-toggle]');
      if (!btn) return;
      const isLight = document.documentElement.classList.toggle('light');
      try {
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      } catch {}
    });
  })();
</script>
